/* ============================================================
   CATL Four-Layer Mapping Engine - Product Site v2
   Style Sheet
   UTF-8: No Chinese mojibake allowed
   ============================================================ */

:root {
    --bg-main: #f9f9f9;
    --paper-white: #ffffff;
    --text-primary: #2d3748;
    --text-secondary: #4a5568;
    --text-muted: #a0aec0;
    --accent-blue: #4a90e2;
    --accent-dark: #2c5282;
    --success-green: #48bb78;
    --warning-orange: #ed8936;
    --danger-red: #e53e3e;
    --border-soft: #e2e8f0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
}

* { box-sizing: border-box; }

body {
    margin: 0;
    padding: 0;
    font-family: 'Noto Sans SC', sans-serif;
    background-color: var(--bg-main);
    color: var(--text-primary);
    line-height: 1.6;
}

h1, h2, h3, h4, h5 {
    font-family: 'Noto Serif SC', serif;
    margin-top: 0;
}

.container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ============================================================
   HEADER
   ============================================================ */
.site-header {
    background: var(--paper-white);
    border-bottom: 1px solid var(--border-soft);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 100;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-area h1 {
    font-size: 1.5rem;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.badge {
    background: var(--text-primary);
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: sans-serif;
}

.main-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    margin-left: 20px;
    font-weight: 500;
    transition: color 0.2s;
}

.main-nav a:hover { color: var(--accent-blue); }
.main-nav a.active {
    color: var(--accent-dark);
    border-bottom: 2px solid var(--accent-dark);
    padding-bottom: 5px;
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 4px;
    font-weight: 500;
    font-family: 'Noto Sans SC', sans-serif;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-block;
}

.btn-primary { background: var(--accent-dark); color: white; }
.btn-primary:hover { background: var(--accent-blue); }

.btn-secondary {
    background: var(--paper-white);
    border: 1px solid var(--border-soft);
    color: var(--text-primary);
}
.btn-secondary:hover { background: #edf2f7; }

.btn-sm { padding: 6px 14px; font-size: 0.85rem; }

/* ============================================================
   ALERTS
   ============================================================ */
.alert {
    padding: 15px 20px;
    border-radius: 4px;
    margin-bottom: 20px;
    line-height: 1.5;
}
.alert.warning {
    background: #feebc8;
    color: #9c4221;
    border-left: 4px solid var(--warning-orange);
}
.alert.info {
    background: #ebf8ff;
    color: #2b6cb0;
    border-left: 4px solid var(--accent-blue);
}
.alert.success {
    background: #c6f6d5;
    color: #276749;
    border-left: 4px solid var(--success-green);
}

/* ============================================================
   HERO SECTION (Homepage)
   ============================================================ */
.hero-section {
    display: flex;
    gap: 40px;
    margin-top: 60px;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--border-soft);
    align-items: center;
}

.hero-content { flex: 3; }
.hero-content h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: var(--accent-dark);
}
.hero-content p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 25px;
}

.cta-group { display: flex; gap: 15px; flex-wrap: wrap; }

.hero-graphic {
    flex: 2;
    display: flex;
    flex-direction: column;
    gap: 15px;
    justify-content: center;
}

.mapping-box {
    padding: 22px 24px;
    border-radius: 8px;
    font-weight: 600;
    text-align: center;
    color: white;
    box-shadow: var(--shadow-md);
    transition: transform 0.2s;
}
.mapping-box:hover { transform: translateX(5px); }
.mapping-box.field   { background: linear-gradient(135deg, #3182ce, #2c5282); }
.mapping-box.evidence { background: linear-gradient(135deg, #38a169, #276749); }
.mapping-box.assurance { background: linear-gradient(135deg, #dd6b20, #c05621); }
.mapping-box.access  { background: linear-gradient(135deg, #e53e3e, #c53030); }

/* ============================================================
   CARDS (Homepage)
   ============================================================ */
.cards-section {
    display: flex;
    gap: 30px;
    margin-top: 50px;
    margin-bottom: 80px;
}

.card {
    background: var(--paper-white);
    padding: 30px;
    border-radius: 8px;
    flex: 1;
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s;
}
.card:hover { box-shadow: var(--shadow-md); }
.card h3 { color: var(--accent-dark); margin-bottom: 15px; font-size: 1.1rem; }
.card p { color: var(--text-secondary); font-size: 0.95rem; margin: 0; }

/* ============================================================
   INTRO / SYSTEM STORY SECTION
   ============================================================ */
.system-story {
    background: var(--paper-white);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 40px;
    margin: 40px 0;
}

.system-story h3 {
    color: var(--accent-dark);
    margin-bottom: 20px;
}

.four-layer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 25px;
}

.layer-item {
    padding: 20px;
    border-radius: 6px;
    text-align: center;
    color: white;
}

.layer-item h4 { margin: 0 0 8px; font-size: 1rem; }
.layer-item p { margin: 0; font-size: 0.8rem; opacity: 0.9; }
.layer-item:nth-child(1) { background: #3182ce; }
.layer-item:nth-child(2) { background: #38a169; }
.layer-item:nth-child(3) { background: #dd6b20; }
.layer-item:nth-child(4) { background: #e53e3e; }

/* ============================================================
   PAGE TOOLS BAR
   ============================================================ */
.page-tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 40px;
    margin-bottom: 20px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 15px;
    flex-wrap: wrap;
    gap: 15px;
}

.page-tools h2 { margin: 0; font-size: 1.6rem; }
.page-tools .subtitle { color: var(--text-secondary); font-size: 0.9rem; margin: 4px 0 0; }
.page-tools .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

/* ============================================================
   INTAKE PAGE
   ============================================================ */
#status-bar { margin-top: 15px; }

.intake-container {
    display: flex;
    gap: 30px;
    margin-bottom: 60px;
    align-items: flex-start;
}

.intake-sidebar {
    flex: 0 0 220px;
    position: sticky;
    top: 80px;
}

.intake-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    background: white;
    overflow: hidden;
}

.intake-sidebar li { border-bottom: 1px solid var(--border-soft); }
.intake-sidebar li:last-child { border-bottom: none; }

.intake-sidebar a {
    display: block;
    padding: 13px 18px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: all 0.15s;
}

.intake-sidebar a:hover,
.intake-sidebar a.active {
    background: #edf2f7;
    color: var(--accent-dark);
    font-weight: 600;
    border-left: 3px solid var(--accent-dark);
}

.intake-form { flex: 1; min-width: 0; }

.form-group-section {
    background: white;
    padding: 30px;
    border-radius: 8px;
    border: 1px solid var(--border-soft);
    margin-bottom: 30px;
    box-shadow: var(--shadow-sm);
}

.form-group-section h3 {
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 10px;
    margin-bottom: 20px;
    font-size: 1rem;
    color: var(--accent-dark);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.form-field { display: flex; flex-direction: column; }
.form-field label {
    font-size: 0.88rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--text-primary);
}

.form-field .en-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.form-field input,
.form-field select,
.form-field textarea {
    padding: 8px 12px;
    border: 1px solid var(--border-soft);
    border-radius: 4px;
    font-family: 'Noto Sans SC', sans-serif;
    font-size: 0.9rem;
    background: #fafafa;
    transition: border-color 0.2s;
}

.form-field input:focus,
.form-field select:focus {
    outline: none;
    border-color: var(--accent-blue);
    background: white;
}

.form-field .note {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
}

.form-field .badge-required {
    display: inline-block;
    background: var(--accent-dark);
    color: white;
    font-size: 0.65rem;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 5px;
}

/* ============================================================
   OUTPUTS PAGE (Hub)
   ============================================================ */
.output-hub {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin: 40px 0 60px;
}

.output-card {
    background: var(--paper-white);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 35px 30px;
    transition: all 0.2s;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    display: block;
}

.output-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    border-color: var(--accent-blue);
}

.output-card .card-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

.output-card h3 { color: var(--accent-dark); margin-bottom: 10px; }
.output-card p { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 20px; }
.output-card .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-soft);
    padding-top: 15px;
}

.output-card .card-footer span {
    font-size: 0.8rem;
    color: var(--text-muted);
}

/* ============================================================
   TABS (Output Detail Pages)
   ============================================================ */
.tabs-container { margin-bottom: 60px; }

.tab-header {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 0;
    overflow-x: auto;
}

.tab-btn {
    background: none;
    border: none;
    padding: 10px 20px;
    font-size: 0.9rem;
    font-family: 'Noto Sans SC', sans-serif;
    cursor: pointer;
    color: var(--text-secondary);
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color 0.2s;
}

.tab-btn:hover { color: var(--accent-blue); }
.tab-btn.active {
    color: var(--accent-dark);
    border-bottom: 3px solid var(--accent-dark);
    font-weight: 600;
}

.tab-content {
    display: none;
    background: white;
    padding: 30px;
    border: 1px solid var(--border-soft);
    border-top: none;
    border-radius: 0 0 8px 8px;
}

.tab-content.active { display: block; }

.tab-content h3 {
    color: var(--accent-dark);
    margin-bottom: 15px;
    font-size: 1.1rem;
}

.tab-content p { color: var(--text-secondary); margin-bottom: 15px; }

/* ============================================================
   SUMMARY CARDS (Output Pages)
   ============================================================ */
.summary-cards { margin: 20px 0; }

.summary-card {
    background: var(--paper-white);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 20px 25px;
    min-width: 140px;
    box-shadow: var(--shadow-sm);
}

.sc-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
}

.sc-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-dark);
    font-family: 'Noto Sans SC', sans-serif;
}

/* ============================================================
   DATA TABLES
   ============================================================ */
.table-responsive { overflow-x: auto; margin-top: 15px; }

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
}

th {
    text-align: left;
    padding: 11px 14px;
    border-bottom: 2px solid var(--border-soft);
    background: #f7fafc;
    color: var(--text-secondary);
    font-weight: 600;
    white-space: nowrap;
    font-size: 0.82rem;
}

td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-soft);
    color: var(--text-primary);
    vertical-align: top;
}

tr:hover { background-color: #f0f7ff; }
tr:last-child td { border-bottom: none; }

/* Status badges */
.status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
}

.badge-green  { background: #c6f6d5; color: #276749; }
.badge-blue  { background: #ebf8ff; color: #2b6cb0; }
.badge-orange{ background: #feebc8; color: #9c4221; }
.badge-red   { background: #fed7d7; color: #c53030; }
.badge-gray  { background: #edf2f7; color: #4a5568; }

/* Evidence status indicators */
.evidence-ok       { color: var(--success-green); }
.evidence-missing  { color: var(--warning-orange); }
.evidence-partial  { color: var(--danger-red); }

/* ============================================================
   EMPTY STATE
   ============================================================ */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}

.empty-state p { margin-bottom: 20px; }

/* ============================================================
   FOOTER
   ============================================================ */
.site-footer {
    text-align: center;
    padding: 40px 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border-soft);
    margin-top: 60px;
}

/* ============================================================
   LOADING INDICATOR
   ============================================================ */
.loading {
    text-align: center;
    padding: 30px;
    color: var(--text-muted);
}

.loading::after {
    content: '';
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-soft);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 10px;
    vertical-align: middle;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
    .hero-section { flex-direction: column; }
    .four-layer-grid { grid-template-columns: repeat(2, 1fr); }
    .output-hub { grid-template-columns: 1fr; }
    .intake-container { flex-direction: column; }
    .intake-sidebar { flex: none; width: 100%; }
    .form-row { grid-template-columns: 1fr; }
}
